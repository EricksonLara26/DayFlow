# Django
SECRET_KEY=CHANGE_ME_WITH_A_RANDOM_DJANGO_SECRET_KEY
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
ENABLE_API_DOCS=True

# Producción: solo HTTPS y hosts/orígenes reales, sin comodines.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
SECURE_SSL_REDIRECT=False
# True solo si el proxy controlado reemplaza X-Forwarded-Proto.
TRUST_X_FORWARDED_PROTO=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
LOG_LEVEL=INFO

# MySQL
DB_NAME=dayflow_db
DB_USER=dayflow_app
DB_PASSWORD=CHANGE_ME_WITH_THE_LOCAL_MYSQL_PASSWORD
DB_HOST=127.0.0.1
DB_PORT=3306
DB_CONN_MAX_AGE=0
# Obligatorio para MySQL remoto en producción.
DB_SSL_CA=

# JWT de desarrollo
JWT_SIGNING_KEY=CHANGE_ME_WITH_A_RANDOM_JWT_SIGNING_KEY
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=1
JWT_REFRESH_COOKIE_NAME=dayflow_refresh
# False solo para desarrollo local por HTTP. En producción debe ser True.
JWT_REFRESH_COOKIE_SECURE=False
JWT_REFRESH_COOKIE_SAMESITE=Lax

# Contraseñas
PASSWORD_MIN_LENGTH=12

# Caché compartida. Producción requiere Redis; no incluyas credenciales reales
# en archivos versionados. Vacío usa LocMem únicamente para desarrollo.
CACHE_URL=
CACHE_KEY_PREFIX=dayflow

# Límites de frecuencia
API_ANON_THROTTLE_RATE=60/minute
API_USER_THROTTLE_RATE=600/minute
AUTH_LOGIN_THROTTLE_RATE=5/minute
AUTH_REFRESH_THROTTLE_RATE=10/minute
AUTH_LOGOUT_THROTTLE_RATE=10/minute
AUTH_PASSWORD_CHANGE_THROTTLE_RATE=5/hour

# Adjuntos de tickets
TICKET_ATTACHMENT_MAX_MB=10
# Debe ser mayor que TICKET_ATTACHMENT_MAX_MB por el overhead multipart.
REQUEST_MAX_MB=12

# Frontend Vite
# Vite solo expone al navegador variables cuyo nombre comienza con VITE_.
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
