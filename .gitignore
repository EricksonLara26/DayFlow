# Dependencias y salida de build.
node_modules/
.pnpm-store/
dist/

# Variables de entorno y archivos locales.
.env
.env.*
!.env.example
*.local

# Python y Django.
backend/.venv/
__pycache__/
*.py[cod]
*.sqlite3
.pytest_cache/
.coverage
htmlcov/
coverage.xml
backend/media/
backend/staticfiles/

# Entornos locales de clientes API; conservar solo los ejemplos sin secretos.
backend/docs/postman/*.local.postman_environment.json
backend/docs/postman/*.private.json

# Editores y sistema operativo.
.idea/
.vscode/
.DS_Store
Thumbs.db

# Artefactos temporales generados durante exportaciones y revisiones.
tmp/
output/

# Logs generados por Vite/pnpm durante pruebas locales.
*.log
*.err.log
